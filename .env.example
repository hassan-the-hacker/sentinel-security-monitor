# =========================================================================
# SENTINEL - CYBERSECURITY HEALTH MONITOR
# Environment Configuration Template (.env.example)
# =========================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# Then fill in your real Supabase credentials.

# -------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION CONFIGURATION
# -------------------------------------------------------------------------
# 1. NEXT_PUBLIC_SUPABASE_URL:
#    Where to find: Supabase Dashboard -> Project Settings -> API -> Project URL
#    Format: https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. NEXT_PUBLIC_SUPABASE_ANON_KEY (Publishable Key):
#    Where to find: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'anon' (public)
#    (Also supports NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here

# 3. SUPABASE_SERVICE_ROLE_KEY (Optional / Secret):
#    Where to find: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'service_role' (secret)
#    CAUTION: Used strictly in backend administrative tools. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -------------------------------------------------------------------------
# APPLICATION RUNTIME CONFIGURATION
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -------------------------------------------------------------------------
# SECURITY SCANNER CONSTRAINTS (Passive non-invasive engine)
# -------------------------------------------------------------------------
SCAN_TIMEOUT_MS=8000
MAX_REDIRECTS=5
